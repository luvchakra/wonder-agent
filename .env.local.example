# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored — never commit real secrets.
#
# For deployment, set these as encrypted environment variables in the
# hosting platform's project settings (e.g. Vercel), never in a committed file.

# Safe for client-side use.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose to browser code, logs, or source control.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Symmetric key used by lib/security/encryptSecret.ts for
# envelope-encrypting integration credentials and other stored secrets.
# Generate with: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=

# Server-only, optional (PLATFORM-P0-05.2). The platform-wide default
# OpenAI/Gemini API keys used by lib/ai/summarize.ts for tenants that have
# not configured their own bring-your-own-key. Leave unset to run
# BYOK-only — tenants without their own key will see "Connect an AI
# provider" instead of a summary.
PLATFORM_OPENAI_API_KEY=
PLATFORM_GEMINI_API_KEY=

# Server-only, optional (OPERATIONS-P0-02.1). Resend powers the email
# channel for the 7 mandatory P0 notification types. Leave both unset to
# run in-app-only — no error, notify() just skips the email send.
# RESEND_FROM_EMAIL must be an address on a domain verified in your Resend
# account (https://resend.com/domains), e.g. notifications@yourdomain.com.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Server-only (COMPLIANCE-P0-05). Shared secret Vercel Cron sends as
# `Authorization: Bearer $CRON_SECRET` when invoking
# app/api/cron/compliance-escalate-overdue/route.ts on the schedule
# defined in vercel.json. Set the same value in the hosting platform's
# encrypted environment variables. Generate with: openssl rand -base64 32
CRON_SECRET=

# Server-only, optional (INTEGRATION-P0-11). The outbound SSRF guard refuses
# connector URLs on loopback, private, link-local and other internal
# networks, and http:// addresses. Set to exactly "true" ONLY for local
# development or the test suite (whose MCP stubs listen on 127.0.0.1).
# Never set it in production. Cloud metadata endpoints stay blocked even
# when it is set.
OUTBOUND_ALLOW_PRIVATE_NETWORKS=

# FOUNDATION-P0-22 — tenant addresses. With this set, each organization is
# reached at https://<slug>.<BASE_APP_HOST> (e.g. BASE_APP_HOST=wonderid.example
# gives https://acme.wonderid.example). The address only names the
# organization: access still needs an active membership there. The bare host
# keeps the organization switcher. Production needs a wildcard domain
# (*.<BASE_APP_HOST>) on the Vercel project. Local development and the E2E
# suite use BASE_APP_HOST=localhost (Chromium resolves *.localhost to this
# machine). Leave unset to disable tenant addresses entirely.
BASE_APP_HOST=
