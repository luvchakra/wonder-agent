# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored — never commit real secrets.
#
# For deployment, set these as encrypted environment variables in the
# hosting platform's project settings (e.g. Vercel), never in a committed file.

# Safe for client-side use.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose to browser code, logs, or source control.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Symmetric key used by lib/security/encryptSecret.ts for
# envelope-encrypting integration credentials and other stored secrets.
# Generate with: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=
